[Unit]
Description=Distributed Worker {{ worker_id }}
After=network.target

[Service]
WorkingDirectory={{ remote_dir }}
Environment="VCLUSTER_CONFIG_BUILDER={{ vcluster_config_builder }}"
ExecStart={{ remote_dir }}/{{ worker_bin }} \
  --id={{ worker_id }} \
  --address={{ worker_ip }}:{{ worker_port }} \
  --mode={{ mode }} {% if naive_arg %}{{ naive_arg }}{% endif %}
StandardOutput=append:{{ log_dir }}/{{ worker_id }}.log
StandardError=inherit
Restart=always
RuntimeDirectory=vcluster-system
RuntimeDirectoryMode=0755

[Install]
WantedBy=default.target

